{
  "httpd": {
    "service": {
      "drain_seconds": 28,
      "interrupt": "ipc:///tmp/interrupt",
      "listen": "tcp://*:8002",
      "loopback": "ipc:///tmp/loopback",
      "shutdown_seconds": 1,
      "timeout_seconds": -1
    }
  },
  "loki": {
    "actions": [
      "locate",
      "route",
      "height",
      "sources_to_targets",
      "optimized_route",
      "isochrone",
      "trace_route",
      "trace_attributes",
      "transit_available",
      "expansion",
      "centroid",
      "status"
    ],
    "logging": {
      "color": true,
      "long_request": 100.0,
      "type": "std_out"
    },
    "service": {
      "proxy": "ipc:///tmp/loki"
    },
    "service_defaults": {
      "heading_tolerance": 60,
      "minimum_reachability": 10,
      "node_snap_tolerance": 10,
      "radius": 100,
      "search_cutoff": 50000,
      "street_side_max_distance": 1000,
      "street_side_tolerance": 5
    },
    "use_connectivity": true
  },
  "mjolnir": {
    "tile_dir": "/data/valhalla_tiles",
    "tile_extract": "/data/valhalla_tiles.tar",
    "timezone": "/data/timezones.sqlite",
    "auto_include": [],
    "admin": {}
  },
  "thor": {
    "service": {
      "proxy": "ipc:///tmp/thor"
    },
    "logging": {
      "long_request": 10,
      "type": "std_out"
    },
    "source": "valhalla_tiles",
    "max_alternates": 1,
    "exclude_polygons": []
  },
  "odin": {
    "service": {
      "proxy": "ipc:///tmp/odin"
    },
    "logging": {
      "type": "std_out"
    },
    "description": "valhalla",
    "mode": "auto",
    "language": "it-IT",
    "directions_options": {
      "units": "kilometers"
    }
  },
  "skadi": {
    "actually_do_work": true,
    "tile_dir": "/data/elevation_tiles",
    "tile_extract": "/data/elevation.tar"
  },
  "meili": {
    "service": {
      "proxy": "ipc:///tmp/meili"
    },
    "mode": "auto",
    "verbose": false,
    "default": {
      "sigma_z": 4.07,
      "gps_accuracy": 5.0,
      "beta": 3,
      "max_route_distance_factor": 5,
      "max_route_time_factor": 5,
      "max_search_radius": 100,
      "breakage_distance": 2000,
      "interpolation_distance": 10,
      "search_radius": 50,
      "geometry": false,
      "route": true,
      "turn_penalty_factor": 0
    }
  },
  "service_limits": {
    "max_matrix_distance": 500000.0,
    "max_matrix_locations": 50,
    "max_routes_distance": 500000.0,
    "max_routes_locations": 50,
    "max_timedistance_distance": 500000.0,
    "max_timedistance_locations": 50,
    "max_trace_distance": 200000.0,
    "max_trace_locations": 300,
    "max_alternates": 2,
    "max_isochrone_distance": 25000.0,
    "max_location_distance": 50000.0,
    "max_exclude_polygons": 10
  },
  "costing": {
    "pedestrian": {
      "type": "pedestrian",
      "shorter": false,
      "walking_speed": 5.1,
      "walkway_factor": 1.0,
      "alley_factor": 1.0,
      "driveway_factor": 5.0,
      "pedestrian": {
        "use_ferry": 0.5,
        "use_lit": 0.9,
        "use_lit_factor": 0.9,
        "use_highway": 0.6,
        "use_highway_factor": 0.6,
        "use_tracks": 1.0,
        "use_tracks_factor": 1.0,
        "use_paths": 1.0,
        "use_paths_factor": 1.0
      },
      "speed_factor": 1.0,
      "max_hiking_difficulty": 3,
      "exclude_polygons": []
    },
    "bicycle": {
      "type": "bicycle",
      "bicycle": {
        "use_roads": 0.85,
        "use_living_streets": 0.9,
        "use_tracks": 0.8,
        "use_hills": 0.85
      },
      "cycling_speed": 14
    }
  }
}
